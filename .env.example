# Salin jadi .env untuk jalan lokal (node server.js).
# Di Vercel: isi di Project Settings > Environment Variables.

# URL endpoint OpenAI-compatible (sampai /v1)
AI_BASE_URL=http://localhost:20128/v1
# Sumber URL tunnel (isi url.txt dari repo 9router). Isi 'off' buat matiin dan pakai AI_BASE_URL aja.
AI_URL_SOURCE=https://raw.githubusercontent.com/WatashiSenseiGalirus/9router/main/url.txt
# Cuma kalau repo 9router PRIVATE: token GitHub (read-only, scope repo)
GITHUB_TOKEN=
# API key endpoint lu
AI_API_KEY=
# Model default
AI_MODEL=Akunfree
# (Opsional tapi disarankan kalau deploy publik) password buat buka web-nya
APP_PASSWORD=

# Pembatasan laju (opsional). Data chat tidak disimpan di server; tiap browser punya sesi sendiri.
RATE_LIMIT_PER_MIN=20        # permintaan/menit per sesi browser
RATE_LIMIT_PER_IP_MIN=60     # permintaan/menit per IP (semua sesi)
MAX_CONCURRENT=2             # balasan yang boleh jalan bersamaan per sesi
MAX_BODY_KB=512
